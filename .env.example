# Copy to apps/api/.env. Never commit production secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beacon
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
WEB_ORIGIN=http://localhost:5173
PORT=4000
# Firebase service account values (optional; push stays queued without them)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
